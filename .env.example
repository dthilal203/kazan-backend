# Sunucu
PORT=3000
JWT_SECRET=bunu-gercek-bir-uygulamada-mutlaka-degistir
BASE_URL=http://localhost:3000

# Google Cloud Console'dan alınacak gerçek OAuth kimlik bilgileri
# (README.md içindeki "Google Cloud kurulumu" bölümüne bak)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# Opsiyonel — tanınmayan e-posta şablonları için LLM tabanlı çıkarım.
# Boş bırakılırsa sistem sadece kural tabanlı (regex) tespiti kullanır.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Tarama sıklığı (dakika) — Gmail push/Pub-Sub kurulmadığı sürece
# gerçek zamanlılık bu polling aralığına bağlıdır.
SYNC_INTERVAL_MINUTES=15
